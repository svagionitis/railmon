# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
tab_width = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{js,ts,jsx,tsx,css,html}]
indent_style = space
indent_size = 2
tab_width = 2

[*.sh]
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
